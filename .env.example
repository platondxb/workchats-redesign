# Public site origin used for canonical URLs, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://www.workchats.com

# Google Analytics 4 measurement ID. Leave empty to ship no analytics and no consent banner.
# When set, analytics loads only after a visitor accepts (see src/components/consent).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: origin of the existing site. Routes this app doesn't serve yet (/pricing, /features/..., /blog)
# are proxied there, so every current URL keeps working during the migration.
LEGACY_SITE_ORIGIN=
