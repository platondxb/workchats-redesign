# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/playwright-report/
/test-results/
/playwright/.cache/

# keep the committed example env file
!.env.example

# local tooling (Claude Code preview config, vendored agent skills, editor settings and worktrees)
/.claude/
/.agents/
/.vscode/

# working files: development artifacts rather than anything the site ships.
# Every path below is already tracked, so these rules only keep NEW files out — git ignores untracked
# paths, never tracked ones. Untracking is a separate, deliberate step (see git rm --cached).
/CLAUDE.md
/AGENTS.md
/docs/
/scripts/
/skills-lock.json

# deploy credentials: an ssh key generated inside the repository would be root on the server
deploy_key
deploy_key.pub

# logs and OS droppings
*.log
logs/
._*
.Spotlight-V100/
.Trashes
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# third-party mood references for the redesign (not licensed for redistribution; see docs/redesign/assets.md)
/docs/redesign/references/
